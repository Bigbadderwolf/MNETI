# ── SOLANA ─────────────────────────────────────────────────
SOLANA_RPC_URL=http://localhost:8899
RELAY_OPERATOR_PRIVATE_KEY=
ORACLE_PROGRAM_ID=
KESH_PROGRAM_ID=
COMPLIANCE_PROGRAM_ID=

# ── M-PESA DARAJA API ────────────────────────────────────────
# Get from: https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_B2C_INITIATOR_NAME=
DARAJA_B2C_SECURITY_CREDENTIAL=
DARAJA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
DARAJA_B2C_TIMEOUT_URL=https://your-domain.com/api/mpesa/b2c/timeout
DARAJA_B2C_RESULT_URL=https://your-domain.com/api/mpesa/b2c/result
DARAJA_ENVIRONMENT=sandbox

# ── MULTI-COUNTRY MOBILE MONEY ───────────────────────────────
# Tanzania — Vodacom M-Pesa Tanzania
TANZANIA_MPESA_API_KEY=
TANZANIA_MPESA_BASE_URL=https://openapi.m-pesa.com

# Uganda — Airtel Money
UGANDA_AIRTEL_CLIENT_ID=
UGANDA_AIRTEL_SECRET=
UGANDA_AIRTEL_BASE_URL=https://openapi.airtel.africa

# Rwanda — MTN Mobile Money
RWANDA_MTN_SUBSCRIPTION_KEY=
RWANDA_MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com

# ── SERVER ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── ORACLE ──────────────────────────────────────────────────
SIX_API_KEY=
SIX_API_BASE_URL=https://web.api.six-group.com/api/findata/v1
PYTH_DEVNET_URL=https://hermes-beta.pyth.network
RELAY_INTERVAL_SECONDS=30

# ── OFFLINE QUEUE ────────────────────────────────────────────
SQLITE_DB_PATH=./data/mneti_queue.db
QUEUE_RETRY_INTERVAL_SECONDS=30
QUEUE_MAX_RETRIES=5

# ── LOGGING ─────────────────────────────────────────────────
LOG_LEVEL=info
