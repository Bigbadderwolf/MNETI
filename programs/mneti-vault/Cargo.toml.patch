# ─────────────────────────────────────────────────────────────────────────────
# Root Cargo.toml — Phase 5 Addition
#
# In your existing MNETI/Cargo.toml, add "programs/mneti-vault" to [workspace] members:
# ─────────────────────────────────────────────────────────────────────────────
#
# [workspace]
# members = [
#     "programs/mneti-rbac",
#     "programs/mneti-vault-registry",
#     "programs/mneti-kesh",
#     "programs/mneti-oracle",
#     "programs/mneti-compliance",
#     "programs/mneti-vault",          ← ADD THIS
# ]
# resolver = "2"
#
# ─────────────────────────────────────────────────────────────────────────────

[workspace]
members = [
    "programs/mneti-rbac",
    "programs/mneti-vault-registry",
    "programs/mneti-kesh",
    "programs/mneti-oracle",
    "programs/mneti-compliance",
    "programs/mneti-vault",
]
resolver = "2"

[profile.release]
overflow-checks = true
lto = "fat"
codegen-units = 1
[profile.release.build-override]
opt-level = 3
incremental = false
codegen-units = 1
